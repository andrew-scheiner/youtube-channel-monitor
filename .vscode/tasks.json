{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Git: Commit & Push (prompt)",
      "type": "shell",
      "command": "git add . && git commit -m \"${input:commitMessage}\" && git push",
      "options": {
        "shell": {
          "executable": "cmd.exe",
          "args": ["/d", "/c"]
        }
      },
      "group": "git",
      "problemMatcher": []
    },
    {
      "label": "Git: Commit & Push (editor)",
      "type": "shell",
      "command": "git add . && git commit && git push",
      "options": {
        "shell": {
          "executable": "cmd.exe",
          "args": ["/d", "/c"]
        }
      },
      "group": "git",
      "problemMatcher": []
    },
    {
      "label": "CLASP: Pull from Google",
      "type": "shell",
      "command": "clasp pull",
      "options": {
        "shell": {
          "executable": "cmd.exe",
          "args": ["/d", "/c"]
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "CLASP: Push to Google",
      "type": "shell",
      "command": "clasp push",
      "options": {
        "shell": {
          "executable": "cmd.exe",
          "args": ["/d", "/c"]
        }
      },
      "group": "build",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "commitMessage",
      "type": "promptString",
      "description": "Commit message",
      "default": "Update YouTube Video Monitor"
    }
  ]
}
